{
  "name": "bailin",
  "version": "0.0.12",
  "private": true,
  "description": "深度蒸馏造人，请上桌面 —— 开源本地 AI 桌宠，用 ta 的视角陪你看问题",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "preinstall": "node scripts/install/preflight.mjs",
    "setup": "node scripts/install/friendly-install.mjs",
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter=./apps/desktop run build",
    "postinstall": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm --filter=./apps/desktop run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:install-help": "node --test scripts/install/diagnose-install-error.test.mjs",
    "package:win": "node apps/desktop/scripts/package-win.mjs"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "puppeteer"
    ],
    "packageExtensions": {
      "better-sqlite3": {
        "scripts": {
          "install": "node ../../scripts/install/wrap-better-sqlite3-install.mjs"
        }
      }
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
